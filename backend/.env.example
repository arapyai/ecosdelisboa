APP_NAME=Lisboa por Outros API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lisboa_por_outros
ADMIN_SECRET_KEY=change-me
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Staging/production reject these local defaults when admin_users is empty.
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=lisboa-por-outros-api/0.1
GEOCODING_TIMEOUT_S=10
GEOCODING_API_KEY=
GEOCODING_API_KEY_HEADER=
GEOCODING_API_KEY_QUERY_PARAM=
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
ROUTING_TIMEOUT_S=15
ROUTING_RETRY_COUNT=2
ROUTING_RETRY_BACKOFF_S=0.25
ROUTE_CURATORIAL_VOICE_IDS={}
TRANSLATION_LLM_PROVIDER=claude
TRANSLATION_LLM_MODEL=claude-sonnet-4-6
TRANSLATION_LLM_API_KEY=
TRANSLATION_LLM_BASE_URL=
TRANSLATION_LLM_TIMEOUT_S=30
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_S=60
ELEVENLABS_DEFAULT_VOICE_ID=
AUDIO_STORAGE_DIR=media
AUDIO_PUBLIC_BASE_URL=/media
AUDIO_UPLOAD_MAX_BYTES=26214400
AUDIO_BUNDLE_MAX_BYTES=262144000
AUDIO_BUNDLE_MAX_ENTRIES=5000
AUDIO_WORKER_ENABLED=true
AUDIO_WORKER_POLL_INTERVAL_S=1
